# Supabase (project: design-and-concur, ref gegiwouyrhcexjozkbhh)
NEXT_PUBLIC_SUPABASE_URL=https://gegiwouyrhcexjozkbhh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # Supabase dashboard → Settings → API keys
SUPABASE_SECRET_KEY=sb_secret_...                          # server-only; never expose to the browser

# App
APP_TIMEZONE=America/New_York
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifications (step 5)
RESEND_API_KEY=re_...            # resend.com → API keys
EMAIL_FROM="Design & Concur <notify@your-domain.org>"   # a sender on a domain you verify in Resend
CRON_SECRET=                     # any long random string; Vercel sends it with cron requests
